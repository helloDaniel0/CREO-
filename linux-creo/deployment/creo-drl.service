[Unit]
Description=CREO+ user-space DRL inference service
After=network.target
ConditionPathExists=/dev/creo_drl

[Service]
Type=simple
WorkingDirectory=/opt/creo-plus/linux-creo
ExecStartPre=/bin/sh -c 'echo Y > /sys/module/tcp_creo/parameters/drl_enabled'
ExecStart=/usr/bin/python3 /opt/creo-plus/linux-creo/deployment/creo_drl_daemon.py --checkpoint /opt/creo-plus/ns3-creo/ns3-overlay/contrib/ai/examples/rl-tcp/use-gym/checkpoints/example-smoke.pt --state-dir /var/lib/creo-drl
ExecStopPost=/bin/sh -c 'echo N > /sys/module/tcp_creo/parameters/drl_enabled'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
